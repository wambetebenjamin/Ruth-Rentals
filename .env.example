# Public site
NEXT_PUBLIC_SITE_URL=https://ruthrentals.co.ke
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
NEXT_PUBLIC_SUPPORT_PHONE=+254112272061
NEXT_PUBLIC_SUPPORT_EMAIL=hello@ruthrentals.co.ke

# Google reCAPTCHA v2 checkbox keys. Leave blank to use the local test checkbox.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# The local test checkbox returns the token "demo-pass" when no site key is set.

# Vercel KV (Upstash compatible). Without these the app uses a seeded in memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Blob for owner photos. Without this, small photos are stored inline in KV.
BLOB_READ_WRITE_TOKEN=

# Session signing secret, 32+ random characters.
SESSION_SECRET=replace-with-a-long-random-string

# Enquiries inbox. Without Resend key, enquiries are stored and shown in the dashboard.
ENQUIRY_EMAIL=hello@ruthrentals.co.ke
RESEND_API_KEY=
FROM_EMAIL=enquiries@ruthrentals.co.ke

# Optional analytics and uptime
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Deployment region is pinned to cdg1 in vercel.json.
